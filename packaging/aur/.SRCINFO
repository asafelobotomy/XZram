pkgbase = xzram
	pkgdesc = Cross-distro Linux swap management (zram, swap files, sysctl tuning)
	pkgver = 0.3.0
	pkgrel = 1
	url = https://github.com/asafelobotomy/XZram
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = rust
	makedepends = cargo
	makedepends = cmake
	makedepends = qt6-base
