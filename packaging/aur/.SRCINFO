	depends = polkit
	depends = systemd
	depends = util-linux
	optdepends = systemd-zram-generator: zram swap via systemd-zram-generator
	optdepends = xzram-gui: Qt6 desktop GUI

pkgname = xzram-gui
	pkgdesc = Qt6 GUI for XZram swap management
	depends = xzram
