#!/usr/bin/make -f

export DH_VERBOSE = 1
export CARGO_TARGET_DIR = $(CURDIR)/target

%:
	dh $@

override_dh_auto_build:
	$(MAKE) build build-gui

# The Makefile's *-files targets are the one install list (also used by the RPM spec and
# `make install`), so every package ships the same files, including the uQ Settings page.
override_dh_auto_install:
	$(MAKE) install-cli-files DESTDIR=$(CURDIR)/debian/xzram
	$(MAKE) install-gui-files DESTDIR=$(CURDIR)/debian/xzram-gui

override_dh_installsystemd:
	dh_installsystemd --package=xzram --name=xzramd --no-enable --no-start
